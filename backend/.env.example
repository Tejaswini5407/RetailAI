# RetailAI Backend Environment Configuration Template
# Copy this file to .env or set environment variables in your deployment environment.

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/retailai_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here

# JWT Security Configuration
# IMPORTANT: JWT_SECRET must be a strong, base64-encoded secret key of at least 256 bits (32+ bytes) in production.
JWT_SECRET=your_base64_encoded_secure_jwt_signing_key_at_least_256_bits_here
JWT_EXPIRATION_MS=86400000

# CORS Configuration (Allowed Frontend Origins)
# Comma-separated list of allowed origin URLs.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ML Microservice Endpoint URL
ML_SERVICE_URL=http://localhost:8000
